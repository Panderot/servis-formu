# Fixnote: giriş ve 3 günlük deneme Supabase ile çalışır (sadece hesap; servis kayıtları tarayıcıda kalır).
# Bu dosyayı .env.local adıyla kopyala ve Supabase > Project Settings > API Keys sayfasındaki değerleri yaz.
# Aynı iki değişkeni Vercel > Settings > Environment Variables'a da ekle, sonra yeniden yayınla (Redeploy).
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-KODUN.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ANAHTARIN

# Online ödeme (Stripe). Hepsi dolu ve NEXT_PUBLIC_ODEME_ACIK=1 olunca "Paket seç" ödeme sayfasına gider;
# boşken abonelik eskisi gibi e-postayla açılır. Gizli değerler sadece .env.local'e ve Vercel'e yazılır.
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...): webhook abonelikler tablosuna yazar.
SUPABASE_SECRET_KEY=
# Stripe > Developers > API keys > Secret key (test: sk_test_..., canlı: sk_live_...)
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > uç noktanın Signing secret'ı (whsec_...); yerelde "stripe listen" verir.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_ODEME_ACIK=
